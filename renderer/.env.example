# Renderer Microservice — Environment Variables
# Copy to .env and fill in your values

# HTTP port the renderer listens on
PORT=3001

# Shared secret — must match RENDER_WEBHOOK_SECRET in main app
RENDER_WEBHOOK_SECRET=

# Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=

# Supabase service-role key — bypasses RLS for storage uploads
SUPABASE_SERVICE_KEY=

# Main app base URL — for reference (callbacks use URLs from the payload)
MAIN_APP_URL=

# Number of parallel frame renderers (lower = less RAM, higher = faster renders)
REMOTION_CONCURRENCY=2

# Temp directory for downloaded assets and render output
REMOTION_OUTPUT_DIR=/tmp/renders

# Path to Chromium/Chrome binary
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux/Docker: /usr/bin/chromium (set automatically in Dockerfile)
# If set, this takes priority over REMOTION_CHROME_PATH.
PUPPETEER_EXECUTABLE_PATH=

# Persistent path for Remotion's Chrome download cache.
# On Render.com: mount a Persistent Disk at /data and set this to /data/chrome
# Chrome is downloaded once on first cold start, then reused — saves ~87 MB per restart.
# Leave blank to use Remotion's default tmp cache (re-downloads on every cold start).
REMOTION_CHROME_PATH=
