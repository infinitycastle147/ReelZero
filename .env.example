# ===========================================
# ReelZero Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# -------------------------------------------
# Clerk Authentication
# https://dashboard.clerk.com
# -------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=whsec_...

# -------------------------------------------
# Supabase Database & Storage
# https://supabase.com/dashboard
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -------------------------------------------
# Stripe Payments
# https://dashboard.stripe.com
# -------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_BASIC_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...

# -------------------------------------------
# Google Gemini AI (Text & Image Generation)
# https://aistudio.google.com/apikey
# -------------------------------------------
GEMINI_API_KEY=AI...

# -------------------------------------------
# ElevenLabs Text-to-Speech
# https://elevenlabs.io
# -------------------------------------------
ELEVENLABS_API_KEY=xi_...

# -------------------------------------------
# Video Renderer Service
# Separate microservice for Remotion rendering
# -------------------------------------------
RENDERER_URL=http://localhost:3001
RENDERER_API_KEY=your-renderer-api-key

# -------------------------------------------
# F008: Remotion Rendering Pipeline
# RENDERER_SERVICE_URL: base URL of the ReelZero-Renderer microservice
# RENDER_WEBHOOK_SECRET: shared secret between main app and renderer (x-render-secret header)
# -------------------------------------------
RENDERER_SERVICE_URL=http://localhost:3001
RENDER_WEBHOOK_SECRET=your-shared-webhook-secret-here

# -------------------------------------------
# Pollinations.ai (MVP image generation fallback)
# https://enter.pollinations.ai
# -------------------------------------------
POLLINATIONS_API_KEY=sk_...
